FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/local-api/package.json apps/local-api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/validation/package.json packages/validation/package.json
RUN corepack pnpm install --frozen-lockfile
COPY apps/local-api apps/local-api
COPY packages/shared packages/shared
COPY packages/validation packages/validation
RUN corepack pnpm db:generate && corepack pnpm --filter @farmacore/shared build && corepack pnpm --filter @farmacore/validation build && corepack pnpm --filter @farmacore/local-api build
RUN corepack pnpm --filter @farmacore/local-api deploy --prod --legacy /prod/api
RUN cd /prod/api && node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && groupadd --system farmacore && useradd --system --gid farmacore --home-dir /app farmacore
COPY --from=build --chown=farmacore:farmacore /prod/api /app
USER farmacore
EXPOSE 4310
CMD ["sh","-c","node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma && node dist/main.js"]
